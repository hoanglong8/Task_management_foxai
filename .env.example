# ============================================================
# FOXAI Task Management Platform — Environment Configuration
# Rename this file to .env and fill in your values
# ============================================================

# ── Telegram Bot ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
# For multi-user mode, leave this blank (all authenticated users allowed)
# For single-user legacy mode, set your Telegram user ID
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_ALLOWED_USER_NAME=

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://foxai:foxai_pass@localhost:5432/foxai_tasks
# For SQLite (dev only, not recommended for production):
# DATABASE_URL=sqlite:///./tasks.db

# ── FastAPI / Security ───────────────────────────────────────
JWT_SECRET_KEY=your-very-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Admin Account (seeded on first run) ─────────────────────
ADMIN_EMAIL=hoanglong208@gmail.com
ADMIN_PASSWORD=change_me_immediately
ADMIN_FULL_NAME=Nguyễn Hoàng Long

# ── OpenAI NLP ───────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_KEY_HERE

# ── Zalo OA ──────────────────────────────────────────────────
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OA_ACCESS_TOKEN=
ZALO_WEBHOOK_SECRET=

# ── Facebook Messenger ───────────────────────────────────────
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_VERIFY_TOKEN=foxai_verify_token
FACEBOOK_APP_SECRET=

# ── WhatsApp Business API ────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=foxai_whatsapp_verify

# ── Legacy / Task file (kept for migration) ──────────────────
TASKS_FILE=tasks.json
STANDUP_DIR=./daily

# ── Team members (comma-separated, used for NLP hints) ──────
TEAM_MEMBERS=Nguyễn Hoàng Long,Nguyễn Quốc Anh,Nguyễn Xuân Tiến,Lê Hải Sơn,Lê Ngọc Thắng,Nguyễn Việt Hoàng,Phạm Văn Tụ,Ngô Đức Kiên,Trần Thị Bích Hoài

# ── Reminders ────────────────────────────────────────────────
REMINDER_HOUR=9
REMINDER_MINUTE=0
TIMEZONE=Asia/Ho_Chi_Minh

# ── CORS (web dashboard) ────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://foxai.vn
